# ---------------------------------------------------------------------------
# Digital Companion — local environment template
# Copy to .env (root). Never commit real keys.
# ---------------------------------------------------------------------------

# LLM provider: openrouter (default) or anthropic (direct fallback)
LLM_PROVIDER=openrouter
LLM_EFFORT=low

# OpenRouter (chat, classifier, memory extraction in Part 2)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pin Claude to Anthropic. Clear this if you switch to a non-Anthropic model.
OPENROUTER_PROVIDER=anthropic
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_DATA_COLLECTION=deny

# Optional direct Anthropic fallback when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Deepgram (voice STT Nova-3, TTS Aura-2)
DEEPGRAM_API_KEY=

# LiveKit Cloud (media + agent dispatch)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=companion

# Database — local Docker Postgres (pnpm db:up) or Amazon RDS/Aurora.
# For RDS use the Secrets Manager connection string and SSL.
DATABASE_URL=postgres://companion:companion_dev@localhost:5432/digitalcompanion
DATABASE_SSL=false
# DATABASE_SSL_CA=/etc/ssl/rds-ca.pem

# API
# API_PORT is the local/monorepo name. Cloud runtimes that inject PORT are also supported.
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
CHAT_HISTORY_LIMIT=20
MAX_REPLY_TOKENS=500

# Voice tuning
VOICE_MAX_TOKENS=300
VOICE_STT_MODEL=nova-3
VOICE_TTS_MODEL=aura-2-andromeda-en

# Web (public — safe to expose)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
