# The monorepo normally uses the root .env. If you deploy the agent separately,
# copy this file to apps/agent/.env and fill it in. Never commit real values.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
DEEPGRAM_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=companion
DATABASE_URL=postgres://companion:companion_dev@localhost:5432/digitalcompanion
DATABASE_SSL=false
# DATABASE_SSL_CA=/etc/ssl/rds-ca.pem
VOICE_MAX_TOKENS=300
VOICE_STT_MODEL=nova-3
VOICE_TTS_MODEL=aura-2-andromeda-en
