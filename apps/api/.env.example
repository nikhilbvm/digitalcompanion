# The monorepo normally uses the root .env. If you deploy apps/api separately,
# copy this file to apps/api/.env and fill it in. Never commit real values.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
DATABASE_URL=postgres://companion:companion_dev@localhost:5432/digitalcompanion
DATABASE_SSL=false
# DATABASE_SSL_CA=/etc/ssl/rds-ca.pem
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=companion
# API_PORT is used locally; most cloud runtimes inject PORT instead.
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
CHAT_HISTORY_LIMIT=20
MAX_REPLY_TOKENS=500
